classDiagram
    %% ==================== SERVICES ====================
    class AuthService {
        +login(LoginRequestDTO) LoginResponse
    }
    class UserService {
        +getProfile(String) UserDTO
        +updateProfile(UserDTO)
    }
    class WalletService {
        +getMyCredits(String) List~MyCreditResponse~
        +getMyNatives(String) Optional~MyNativeResponse~
        +handleNativeDeposited(BlockchainEventDTO)
        +handleNativeWithdraw(BlockchainEventDTO)
        +handleCreditDeposited(BlockchainEventDTO)
        +handleCreditWithdraw(BlockchainEventDTO)
        +handleBalanceLocked(BlockchainEventDTO)
        +handleBalanceUnlocked(BlockchainEventDTO)
        +handleTradeSettled(BlockchainEventDTO)
    }
    class ProjectService {
        +createProject(ProjectDTO)
        +approveProject(String)
        +getAllProjects() List~ProjectResponse~
    }
    class PinataService {
        +uploadFileToIPFS(MultipartFile, String) String
        +uploadJsonToIPFS(Map, String) String
    }
    class TradingService {
        +placeOrder(PlaceOrderCommandDTO, String) Order
        +cancelOrder(Order) boolean
        +expireOrder(Order)
        +ensureOrderBookExists(String)
    }
    class SettlementService {
        +addTradeToBatch(TradeEventDTO)
        +settleBatch()
        +handleFailedBatch(List, String)
    }
    class ContractService {
        +lockBalance(String, BigInteger)
        +unlockBalance(String)
        +processBatchSettlement(BigInteger, List, List, List)
        +getLockedBalanceOwner(String)
    }
    class CertificateService {
        +handleBatchCeritificateRetired(BlockchainEventDTO)
        +getCertificatesByUser(String) List~CertificateResponse~
    }
    class KafkaConsumerService {
        +consumeOrder(PlaceOrderCommandDTO)
        +consumeTrade(TradeEventDTO)
        +consumeBlockchainEvent(BlockchainEventDTO)
    }

    %% ==================== RELATIONSHIPS ====================
    AuthService ..> UserService
    AuthService ..> WalletService
    ProjectService ..> PinataService
    KafkaConsumerService ..> SettlementService
    SettlementService ..> ContractService
    ContractService ..> WalletService
