classDiagram
    %% ==================== CONTROLLERS ====================
    class AuthController {
        +login(LoginRequestDTO) ResponseEntity
    }
    class ProjectController {
        +getAllProjects()
        +createProject(ProjectUploadDto)
        +approveProject(String)
        +rejectProject(String)
    }
    class OrderController {
        +placeOrder(PlaceOrderCommandDTO)
        +cancelOrder(String)
        +getOrderBook(String)
    }
    class CertificateController {
        +getMyCertificates()
        +getCertificateDetail(String)
    }
    class RetireRequestController {
        +createRetireRequest(RetireRequestDTO)
    }
    class MarketController
    
    %% ==================== SERVICES ====================
    class AuthService {
        +login(LoginRequestDTO) LoginResponse
    }
    class UserService {
        +getProfile(String) UserDTO
        +updateProfile(UserDTO)
    }
    class WalletService {
        +getMyCredits(String) List~MyCreditResponse~
        +getMyNatives(String) Optional~MyNativeResponse~
        +handleNativeDeposited(BlockchainEventDTO)
        +handleNativeWithdraw(BlockchainEventDTO)
        +handleCreditDeposited(BlockchainEventDTO)
        +handleCreditWithdraw(BlockchainEventDTO)
        +handleBalanceLocked(BlockchainEventDTO)
        +handleBalanceUnlocked(BlockchainEventDTO)
        +handleTradeSettled(BlockchainEventDTO)
    }
    class RoleRequestService {
        +requestRole(String, RoleRequestDTO)
        +approveRoleRequest(String)
        +rejectRoleRequest(String, String)
        +confirmRoleRequest(String)
    }
    class ProjectService {
        +createProject(ProjectDTO)
        +approveProject(String)
        +getAllProjects() List~ProjectResponse~
    }
    class PinataService {
        +uploadFileToIPFS(MultipartFile, String) String
        +uploadJsonToIPFS(Map, String) String
    }
    class TradingService {
        +placeOrder(PlaceOrderCommandDTO, String) Order
        +cancelOrder(Order) boolean
        +expireOrder(Order)
        +ensureOrderBookExists(String)
    }
    class SettlementService {
        +addTradeToBatch(TradeEventDTO)
        +settleBatch()
        +handleFailedBatch(List, String)
    }
    class ContractService {
        +lockBalance(String, BigInteger)
        +unlockBalance(String)
        +processBatchSettlement(BigInteger, List, List, List)
        +getLockedBalanceOwner(String)
    }
    class CertificateService {
        +handleBatchCeritificateRetired(BlockchainEventDTO)
        +getCertificatesByUser(String) List~CertificateResponse~
    }
    class KafkaConsumerService {
        +consumeOrder(PlaceOrderCommandDTO)
        +consumeTrade(TradeEventDTO)
        +consumeBlockchainEvent(BlockchainEventDTO)
    }

    %% ==================== CORE ENGINE ====================
    class MatchingEngine {
        -Map~String, OrderBook~ orderBooks
        +processOrder(PlaceOrderCommandDTO) List~TradeEventDTO~
        +cancelOrder(String, String) boolean
        +getOrderBookSnapshot(String) Map
    }
    class OrderBook {
        -String creditId
        +matchOrder(PlaceOrderCommandDTO) List~TradeEventDTO~
        +addOrder(OrderNode)
        +removeOrder(String) boolean
    }

    %% ==================== ENTITIES ====================
    class User {
        +String id
        +String name
        +String email
        +String roleId
        +String verifierRoleId
        +Boolean isActive
        +String documentHash
        +LocalDateTime createdAt
        +LocalDateTime updatedAt
    }
    class Wallet {
        +String id
        +String address
        +BigDecimal nativeBalance
        +BigDecimal nativeLocked
        +LocalDateTime updatedAt
    }
    class Project {
        +String id
        +String name
        +Integer vintage
        +String ownerId
        +String type
        +String location
        +String description
        +String ipfsHash
        +String status
        +Long totalAmount
        +Long issueAmount
        +Long availableAmount
        +Boolean isListed
    }
    class CarbonCredit {
        +String id
        +String projectId
        +long tokenId
        +long issueAmount
        +long retiredAmount
    }
    class Order {
        +String id
        +String userId
        +String creditId
        +String orderType
        +BigDecimal price
        +Integer amount
        +Integer remainingAmount
        +String status
    }
    class Certificate {
        +String id
        +BigInteger nftTokenId
        +String userId
        +BigInteger totalAmount
        +String txHash
        +LocalDateTime createdAt
    }

    %% ==================== DTOs ====================
    class LoginRequestDTO {
        -String address
        -String message
        -String signature
    }
    class LoginResponse {
        -String token
        -UserDTO user
    }
    class UserDTO {
        -String id
        -String name
        -String roleId
        -String email
        -String documentHash
        -String verifierRoleId
    }
    class RoleRequestDTO {
        -String requestedRole
        -String reason
        -String verifierRoleId
    }
    class ProjectUploadDto {
        -String name
        -String location
        -Integer vintage
        -String description
        -Long totalAmount
        -MultipartFile image
        -MultipartFile document
    }
    class ProjectResponse {
        -String id
        -String name
        -String ownerId
        -String status
        -String ipfsUrl
        -Long availableCredits
    }
    class ProjectWithCreditDTO {
        -String id
        -String name
        -Integer vintage
        -String ownerId
        -String type
        -Long totalAmount
        -Long issueAmount
        -Long retiredAmount
        -Long availableAmount
        -Boolean isListed
    }
    class PlaceOrderCommandDTO {
        -String orderId
        -String userId
        -String creditId
        -String orderType
        -BigDecimal price
        -Integer amount
        -Long timestamp
    }
    class OrderBookUpdateDTO {
        -String creditId
        -List~PriceLevel~ bids
        -List~PriceLevel~ asks
    }
    class TradeEventDTO {
        -String tradeId
        -String buyOrderId
        -String sellOrderId
        -String creditId
        -Integer amount
        -BigDecimal price
        -BigDecimal totalValue
        -LocalDateTime tradeAt
    }
    class BlockchainEventDTO {
        -String eventType
        -String transactionHash
        -BigInteger blockNumber
        -Map~String, Object~ eventData
    }
    class RetireRequestDTO {
        -String onchainTxHash
        -String nftTokenId
        -String reason
        -List~RetireRecordDTO~ records
    }
    class CertificateResponse {
        -String id
        -String nftTokenId
        -String ownerAddress
        -BigInteger totalAmount
        -String txHash
    }

    %% ==================== RELATIONSHIPS ====================
    %% Controller -> Service
    AuthController ..> AuthService
    ProjectController ..> ProjectService
    OrderController ..> TradingService
    CertificateController ..> CertificateService
    RetireRequestController ..> CertificateService

    %% Service -> Service / Component
    AuthService ..> UserService
    AuthService ..> WalletService
    ProjectService ..> PinataService
    TradingService ..> MatchingEngine
    MatchingEngine *-- OrderBook
    KafkaConsumerService ..> SettlementService
    SettlementService ..> ContractService
    ContractService ..> WalletService

    %% Service -> Entity / DTO
    AuthService ..> LoginResponse : Returns
    UserService ..> User : Manages
    ProjectService ..> Project : Manages
    TradingService ..> Order : Manages
    CertificateService ..> Certificate : Manages
    
    %% Kafka
    MatchingEngine ..> TradeEventDTO : Produces
    KafkaConsumerService ..> BlockchainEventDTO : Consumes
