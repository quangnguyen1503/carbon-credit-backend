classDiagram
    %% PART 1: IDENTITY & PROJECT MANAGEMENT

    %% ==================== CONTROLLERS ====================
    class AuthController {
        +login(LoginRequestDTO) ResponseEntity
    }
    class ProjectController {
        +getAllProjects()
        +createProject(ProjectUploadDto)
        +approveProject(String)
        +rejectProject(String)
    }

    %% ==================== SERVICES ====================
    class AuthService {
        +login(LoginRequestDTO) LoginResponse
    }
    class UserService {
        +getProfile(String) UserDTO
        +updateProfile(UserDTO)
    }
    class WalletService {
        +getMyCredits(String) List~MyCreditResponse~
        +getMyNatives(String) Optional~MyNativeResponse~
    }
    class RoleRequestService {
        +requestRole(String, RoleRequestDTO)
        +approveRoleRequest(String)
        +rejectRoleRequest(String, String)
        +confirmRoleRequest(String)
    }
    class ProjectService {
        +createProject(ProjectDTO)
        +approveProject(String)
        +getAllProjects() List~ProjectResponse~
    }
    class PinataService {
        +uploadFileToIPFS(MultipartFile, String) String
        +uploadJsonToIPFS(Map, String) String
    }

    %% ==================== ENTITIES ====================
    class User {
        +String id
        +String name
        +String email
        +String roleId
        +String verifierRoleId
        +Boolean isActive
        +String documentHash
    }
    class Wallet {
        +String id
        +String address
        +BigDecimal nativeBalance
        +BigDecimal nativeLocked
    }
    class Project {
        +String id
        +String name
        +Integer vintage
        +String ownerId
        +String type
        +String location
        +String description
        +String ipfsHash
        +String status
        +Boolean isListed
    }
    class CarbonCredit {
        +String id
        +String projectId
        +long tokenId
        +long issueAmount
        +long retiredAmount
    }

    %% ==================== DTOs ====================
    class LoginRequestDTO {
        -String address
        -String message
        -String signature
    }
    class LoginResponse {
        -String token
        -UserDTO user
    }
    class UserDTO {
        -String id
        -String name
        -String roleId
        -String email
    }
    class ProjectUploadDto {
        -String name
        -String location
        -MultipartFile image
        -MultipartFile document
    }

    %% ==================== RELATIONSHIPS ====================
    AuthController ..> AuthService
    ProjectController ..> ProjectService
    AuthService ..> UserService
    AuthService ..> WalletService
    ProjectService ..> PinataService
    
    UserService ..> User : Manage
    ProjectService ..> Project : Manage
    AuthService ..> LoginResponse : Return
