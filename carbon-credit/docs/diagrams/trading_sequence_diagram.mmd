sequenceDiagram
    participant User
    participant TradingService
    participant Kafka
    participant MatchingEngine
    participant SettlementService
    participant Blockchain

    User->>TradingService: Place Limit Order
    TradingService->>Blockchain: Lock Balance
    Blockchain-->>TradingService: Success
    TradingService->>Kafka: Send Order Event (Topic: orders)
    
    Kafka->>MatchingEngine: Consume Order
    MatchingEngine->>MatchingEngine: Match with OrderBook
    
    alt Match Found
        MatchingEngine->>Kafka: Produce Trade Events (Topic: trades)
        Kafka->>SettlementService: Consume Trade
        SettlementService->>SettlementService: Add to Batch
        
        loop Every 30s or Batch Full
            SettlementService->>Blockchain: Batch Settle (Smart Contract)
            Blockchain-->>SettlementService: Tx Hash
            SettlementService->>Database: Save Settled Trades
        end
    else No Match
        MatchingEngine->>MatchingEngine: Add to OrderBook (RAM)
    end
